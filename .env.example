# Daywell mobile - local environment. Copied from the web app's .env and
# reduced to PUBLIC values only. This file is git-ignored; only .env.example
# is committed (AGENTS.md 15).
#
# !! Every EXPO_PUBLIC_* value is INLINED INTO THE APP BUNDLE and is readable
# !! by anyone who installs the app. A secret here is a leaked secret.
#
# Deliberately NOT copied from the web .env:
#   AUTH0_CLIENT_SECRET, AUTH0_SECRET, PAYSTACK_SECRET_KEY,
#   MAILGUN_API_KEY, CRON_SECRET          -> secrets, never in the app
#   PAYSTACK_PUBLIC_KEY                   -> payment happens on Paystack's hosted page
#   DELIVERY_FEE_MINOR, ORDER_EXPIRY_MINUTES -> server business rules; the app
#                                              must render server values, never its own

# ---------------------------------------------------------------------
# Taken from the web app's .env (public values only)
# ---------------------------------------------------------------------

# 'live' probes the real backend. Use 'mock' until the /api/v1 Tier 1 slice
# is deployed: https://daywell-shop.vercel.app/api/v1/health currently 404s.
EXPO_PUBLIC_API_MODE=mock

# APP_BASE_URL + /api/v1 (PRD 7.1). Must be https:// in release builds.
EXPO_PUBLIC_API_BASE_URL=https://daywell-shop.vercel.app/api/v1

# Bare Auth0 tenant host. Public by design.
EXPO_PUBLIC_AUTH0_DOMAIN=dev-3i3skll2b52f1j5t.us.auth0.com

# ---------------------------------------------------------------------
# TODO(owner) - required before M4 sign-in, see docs/api-contract-notes.md
# ---------------------------------------------------------------------

# The web app's AUTH0_CLIENT_ID is for the SPA (implicit flow) and is NOT
# usable here. Create an Auth0 **Native** application with Authorization Code
# + PKCE and put its client ID here. See docs/auth0-setup.md.
EXPO_PUBLIC_AUTH0_CLIENT_ID=

# The Daywell Auth0 API does not exist yet: the web repo has no
# AUTH0_API_AUDIENCE / AUTH0_AUDIENCE value at all. Create an Auth0 API for
# Daywell and use its identifier (a URI, e.g. https://api.daywell.com).
EXPO_PUBLIC_AUTH0_AUDIENCE=

# ---------------------------------------------------------------------

# Custom scheme for deep links. The Paystack return link is
# daywell://payment-return?reference=... (PRD 7.4). Must match the callback
# URLs registered in the Auth0 Native application. Do not change after release.
EXPO_PUBLIC_APP_SCHEME=daywell