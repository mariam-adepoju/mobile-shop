# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
# Root-only: `types/expo-env.d.ts` is committed so CI has Expo's ambient types.
# The root copy is generated by the Expo CLI and must not be committed.
/expo-env.d.ts

# EAS build artifacts
# Produced in the cloud, but they land here when downloaded to inspect or to
# install by cable.
/*.apk
/*.aab
/*.ipa
eas-build-*.log

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
# Android release signing. `*.jks` is covered above, but `.keystore` is the
# extension Android Studio creates by default. A committed release key lets
# anyone publish an update to this app (AGENTS.md 15).
*.keystore

# iOS
Pods/
Podfile.lock

# Firebase / Google services
# Contain project IDs and API keys. Arrives with a messaging dependency, never
# with the app itself (AGENTS.md 3).
google-services.json
GoogleService-Info.plist

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# editors
# `.vscode/` is deliberately NOT ignored: `extensions.json` and `settings.json`
# are shared project config. Personal overrides belong in
# `.vscode/settings.local.json`, which is ignored below.
.vscode/settings.local.json
.eslintcache

# macOS
.DS_Store
*.pem

# local env files
# Ignore every .env variant, but always keep .env.example (the committed
# contract) and .env templates. Without this, a .env full of Auth0 and API
# values would be picked up by `git add -A` (AGENTS.md 3.1).
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# tests
coverage/

# agent tooling
# Local AI-assistant state. `skills-lock.json` belongs with these: it is the
# lockfile for the skill folders above, not application config.
.agents/
.kiro/
.claude/
skills-lock.json

# generated native folders
# Continuous Native Generation recreates these from app.config.ts, and they are
# never edited by hand (AGENTS.md 4).
/ios
/android
ci-out.txt
verify-out.txt
