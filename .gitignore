# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
# Root-only: `types/expo-env.d.ts` is committed so CI has Expo's ambient types.
/expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# Ignore every .env variant, but always keep .env.example (the committed
# contract) and .env templates. Without this, a web-app .env full of secrets
# sitting in the root would be picked up by `git add -A`.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# tests
coverage/

example

# generated native folders
/ios
/android

.agents/
.kiro/
.claude/
